    {
      "claim_type": "module_role",
      "scope": {
        "type": "module",
        "module": "IONet_slot"
      },
      "summary": "IONet_slot 是一个外设集成槽位，将来自CPU的事件和数据通过片上网络（NoC）多路分发至UART、I2C、PWM、定时器、GPIO、SPI及看门狗等外设，并汇聚外设中断与状态直连信号送交顶层。",
      "subject": "IONet_slot",
      "explanation": "模块内实例cpu2noc_instance将CPU驱动事件i_drvFCPU转换为两个NoC通道事件；uut（IONetwork）作为路由网络连接所有外设端点；大量module_boundary连接（如BAUD_UART0、CKISO_IIC0）表明模块同时承担外设配置直连信号的管理；输出端口INT_TIMER、IRQ_GPIO等直接引出外设中断。整体呈现一个集成的SoC外设槽位角色。",
      "signals": [
        "i_drvFCPU",
        "o_drv2CPU",
        "i_dataFCPU_51",
        "o_data2CPU_51",
        "INT_TIMER",
        "gpio_ctrl_o",
        "gpio_data_o"
      ],
      "instances": [
        "cpu2noc_instance",
        "uut"
      ],
      "related_flows": [
        "flow_000_IONet_slot_i_drvFCPU"
      ],
      "doc_priority": "primary",
      "requires_rtl_source_review": false,
      "confidence": "high",
