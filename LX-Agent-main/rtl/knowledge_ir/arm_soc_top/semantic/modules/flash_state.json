    {
      "claim_type": "module_role",
      "scope": {
        "type": "module",
        "module": "flash_state"
      },
      "summary": "flash_state 是 SPI 闪存控制器状态机模块，负责管理 SPI 主设备与外部闪存之间的读写事务序列。",
      "subject": "flash_state",
      "explanation": "该模块通过实例化 spi_master_spi0 并驱动其控制信号（如 w_spi_en、i_ctl 映射到 CR）来发起 SPI 事务。内部状态机（r_state）控制读写流程，并通过 i_startRead、r_start_spi 等信号触发操作。输出 o_finish 由 w_spi_cs_n 驱动，指示事务完成。",
      "signals": [
        "i_ctl",
        "i_data2spi",
        "o_dataFspi",
        "i_readflag",
        "o_finish",
        "w_spi_en",
        "w_spi_cs_n"
      ],
      "instances": [
        "u_spi_master"
      ],
      "doc_priority": "primary",
      "requires_rtl_source_review": true,
      "confidence": "medium",
      "evidence": [
