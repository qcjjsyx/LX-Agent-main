    {
      "claim_type": "module_role",
      "scope": {
        "type": "module",
        "module": "flash_state"
      },
      "summary": "flash_state 是 SPI 主控制器与外部 Flash 存储器之间的状态驱动桥接模块，负责管理 SPI 事务的启动、数据路由和完成指示。",
      "subject": "flash_state",
      "explanation": "该模块通过内部状态机（r_state）控制 SPI 主控制器实例（u_spi_master）的使能信号（w_spi_en），并将 SPI 主控制器的数据输出（data_out）直接映射到模块输出（o_dataFspi）。其行为由输入控制信号（i_ctl）和读标志（i_readflag）驱动，并通过输出 o_finish 指示事务完成。",
      "signals": [
        "i_ctl",
        "i_readflag",
        "o_finish",
        "o_dataFspi"
      ],
      "instances": [
        "u_spi_master"
      ],
      "doc_priority": "primary",
      "requires_rtl_source_review": true,
      "confidence": "medium",
      "evidence": [
