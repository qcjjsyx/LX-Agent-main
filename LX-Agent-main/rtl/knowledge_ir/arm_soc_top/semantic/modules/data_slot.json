        "module": "data_slot"
      },
      "summary": "Central data routing and arbitration hub between CPU, Dcache, and Mesh domains.",
      "subject": "data_slot",
      "explanation": "The module receives drive events from Dcache, Mesh, and CPU (via cfifo0), arbitrates between Dcache and Mesh data paths using MutexMerge, and routes CPU-originated requests to either Dcache or Mesh via select1. Free signals are propagated back to the source to indicate completion.",
      "signals": [
        "i_driveFromDcache",
        "i_driveFromMesh",
        "i_drvCpu2Mux",
        "o_driveToCpu",
        "o_driveToDcache",
        "o_driveToMesh"
      ],
