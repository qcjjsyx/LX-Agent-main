      "claim_type": "module_role",
      "scope": {
        "type": "module",
        "module": "perip_slot_timer"
      },
      "summary": "该模块作为外围设备槽位定时器，负责在网格网络中延迟和转发驱动事件，并管理相应的释放信号。",
      "subject": "perip_slot_timer",
      "explanation": "模块接收来自网格的驱动事件（i_driveFrmMesh），通过两级FIFO和延迟单元处理后，输出驱动事件（o_driveNextToMesh）到下一个网格节点。同时，它处理释放信号（i_freeNextFrmMesh, o_freeToMesh），形成完整的驱动-释放握手协议。",
      "signals": [
        "i_driveFrmMesh",
        "o_driveNextToMesh",
        "i_freeNextFrmMesh",
        "o_freeToMesh"
      ],
      "instances": [
        "cFifo_1",
        "cFifo_2"
      ],
      "related_flows": [
        "flow_000_perip_slot_timer_i_driveFrmMesh"
      ],
      "doc_priority": "primary",
      "requires_rtl_source_review": false,
