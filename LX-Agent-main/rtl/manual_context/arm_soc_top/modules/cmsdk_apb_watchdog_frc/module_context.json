  "module_responsibility": {
    "short_summary": {
      "value": "APB-programmable watchdog timer with forced reset capability, gated by a lock mechanism.",
      "explanation": "The module decodes APB write transactions to control registers (CONTROL, LOAD, CLEAR) only when frc_sel is asserted and wdog_lock is deasserted, indicating a forced (frc) selection mode that overrides a lock. The output WDOGINT and WDOGRES are driven by internal masked interrupt and reset signals.",
      "certainty": "ai_inferred",
      "confidence": "medium",
      "source_layers": [
        "semantic_layer"
      ],
