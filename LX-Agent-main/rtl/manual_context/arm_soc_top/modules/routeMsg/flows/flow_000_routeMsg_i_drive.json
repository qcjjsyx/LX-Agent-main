  "semantic_meaning": {
    "value": "This flow distributes an incoming drive event from i_drive to five directional arbiter outputs (E, L, N, S, W) via a single fork and per-direction buffered paths.",
    "explanation": "The flow starts at the module input i_drive, passes through a receive FIFO, a delay, a 5-way conditional fork, per-direction delays, and per-direction send FIFOs to produce the five output drive events. The fork is the single branch point, and there are no joins.",
    "certainty": "ai_inferred",
    "confidence": "high",
    "source_layers": [
