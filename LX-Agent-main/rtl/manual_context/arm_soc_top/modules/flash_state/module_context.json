  "module_responsibility": {
    "short_summary": {
      "value": "Top-level SPI flash controller wrapper that instantiates a generic SPI master and manages chip-select sequencing and data gating for flash read/program operations.",
      "explanation": "The module connects external control/data signals to an internal spi_master_spi0 instance, and uses state-dependent assignments (w_spi_en, o_finish) to gate SPI enable and completion signaling based on internal state (r_state) and start conditions (i_startRead, r_start_spi). The absence of event inputs/outputs and event-payload contracts suggests a simple synchronous wrapper with no internal event-driven handshake.",
      "certainty": "ai_inferred",
      "confidence": "medium",
      "source_layers": [
        "semantic_layer"
      ],
      "semantic_claim_id": "semantic:module:flash_state:module_role:001",
